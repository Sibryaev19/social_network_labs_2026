# Пользовательский ключ доступа (OAuth VK ID, scope=wall)

# Сообщество и период сбора (включительно)
VK_GROUP_SCREEN_NAME=samara_university

DATE_FROM=2026-08-01
DATE_TO=2026-08-31

# Постов за один запрос wall.get (лимит API — 100)
POSTS_PER_REQUEST=100

# Формат вывода: json | parquet | both
OUTPUT_FORMAT=json
